pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'REVISION',
            defaultValue: '',
            description: 'Helm revision number to rollback to'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        EKS_CLUSTER_NAME = 'roboshop-dev-eks'
        NAMESPACE = 'mongodb'
        RELEASE_NAME = 'mongodb'
        KUBECONFIG = "${WORKSPACE}/.kube/config"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.REVISION ==~ /[1-9][0-9]*/)) {
                        error('Enter a valid Helm revision number')
                    }
                }
            }
        }

        stage('Configure Kubeconfig') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER_NAME"

                    kubectl get nodes
                '''
            }
        }

        stage('Helm History') {
            steps {
                sh '''
                    helm history "$RELEASE_NAME" \
                        -n "$NAMESPACE"
                '''
            }
        }

        stage('Rollback Approval') {
            steps {
                timeout(time: 1, unit: 'MINUTES') {
                    input message: "Confirm MongoDB rollback to revision ${params.REVISION}?",
                          ok: 'Rollback'
                }
            }
        }

        stage('Rollback MongoDB') {
            steps {
                sh '''
                    helm rollback "$RELEASE_NAME" "$REVISION" \
                        --namespace "$NAMESPACE" \
                        --wait \
                        --timeout 15m
                '''
            }
        }

        stage('Verify Rollback') {
            steps {
                sh '''
                    kubectl rollout status statefulset/mongodb \
                        -n "$NAMESPACE" --timeout=300s

                    kubectl get pods -n "$NAMESPACE" -o wide
                    kubectl get svc -n "$NAMESPACE"
                    kubectl get pvc -n "$NAMESPACE"
                    kubectl get jobs -n "$NAMESPACE"
                    kubectl get externalsecret -n "$NAMESPACE"

                    helm status "$RELEASE_NAME" -n "$NAMESPACE"
                    helm history "$RELEASE_NAME" -n "$NAMESPACE"
                '''
            }
        }
    }

    post {
        success {
            echo 'MongoDB rollback successful'
        }

        failure {
            echo 'MongoDB rollback failed'
        }

        aborted {
            echo 'MongoDB rollback aborted'
        }
    }
}