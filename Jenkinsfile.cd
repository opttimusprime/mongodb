pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'GIT_COMMIT_SHA', defaultValue: '',
               description: 'Git commit validated by CI')
    }

    environment {
        AWS_REGION = 'us-east-1'
        EKS_CLUSTER_NAME = 'roboshop-dev-eks'
        NAMESPACE = 'mongodb'
        RELEASE_NAME = 'mongodb'
        KUBECONFIG = "${WORKSPACE}/.kube/config"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    test -n "$GIT_COMMIT_SHA"
                    git checkout --detach "$GIT_COMMIT_SHA"
                '''
            }
        }

        stage('Configure Kubeconfig') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER_NAME"

                    kubectl get nodes
                '''
            }
        }

        stage('Deploy MongoDB') {
            steps {
                sh '''
                    helm upgrade --install "$RELEASE_NAME" ./helm \
                        --namespace "$NAMESPACE" \
                        --create-namespace \
                        --wait \
                        --timeout 15m
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status statefulset/mongodb \
                        -n "$NAMESPACE" --timeout=300s

                    kubectl get pods -n "$NAMESPACE" -o wide
                    kubectl get svc -n "$NAMESPACE"
                    kubectl get pvc -n "$NAMESPACE"
                    kubectl get jobs -n "$NAMESPACE"
                    kubectl get externalsecret -n "$NAMESPACE"

                    helm status "$RELEASE_NAME" -n "$NAMESPACE"
                '''
            }
        }
    }

    post {
        success {
            echo 'MongoDB deployment successful'
        }

        failure {
            echo 'MongoDB deployment failed'
        }
    }
}